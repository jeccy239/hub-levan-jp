# Local dev (docker compose up -d):
DATABASE_URL="postgresql://levan:levan@localhost:5432/levan_dev?schema=public"

# Production (Vercel Postgres / Neon integration sets these automatically —
# usually as POSTGRES_URL / POSTGRES_URL_NON_POOLING; map them to these two
# names in Vercel's Environment Variables screen):
# DATABASE_URL   = pooled connection string (used by the app at runtime)
# DIRECT_URL     = non-pooled connection string (used only for migrations)

# Set to enable real LLM calls for Agent 01 / Agent 02. Without it, agents
# run in stub mode and return deterministic mock output (see src/agents/llm.ts).
ANTHROPIC_API_KEY=

# Required for auth (NextAuth). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# WEBRIS (webris.levan.jp) admin API — separate product/codebase/DB.
# WEBRIS_API_SECRET must match the value WEBRIS reads as
# LEVANHUB_WEBHOOK_SECRET. See docs/webris-integration.md for the contract.
WEBRIS_API_URL=https://webris.levan.jp
WEBRIS_API_SECRET=

# Anthropic Admin API key (starts with sk-ant-admin...), separate from the
# regular ANTHROPIC_API_KEY used by the sales/SEO agents. Issue one at
# https://console.anthropic.com/settings/admin-keys — used only to read the
# organization's Cost Report for the /webris/claude-usage dashboard.
ANTHROPIC_ADMIN_API_KEY=

# gBizINFO (経済産業省) 法人情報API — 実在企業のプロスペクティングに使用。
# 無料。https://info.gbiz.go.jp/hojin/APIManual から利用申請すると
# 登録メールアドレスにトークンが届く。
GBIZINFO_API_TOKEN=

# メール配信 (Resend)。未設定の場合、一斉配信はDB記録のみのシミュレーション
# として動作し、実際のメールは送信されない。
# MAIL_FROM は Resend でドメイン認証済みのアドレスであること。
RESEND_API_KEY=
MAIL_FROM="株式会社LEVAN <sales@levan.jp>"
MAIL_REPLY_TO=

# 開封・クリック計測リンクの生成に使う自ドメイン
NEXT_PUBLIC_APP_URL=https://hub.levan.jp

# Vercel Cron の認証シークレット。設定すると Vercel が cron 実行時に
# Authorization: Bearer <値> を付与する。/api/cron/* はこれが無いと401。
# 生成: openssl rand -hex 32
CRON_SECRET=
# WEBRIS新規契約の通知先（省略時 email_info@levan.jp）
WEBRIS_CONTRACT_NOTIFY_TO=email_info@levan.jp
# 新規登録者への自動サンクスメールの差出人名（{{sender}} に入る）
SUPPORT_SENDER_NAME=サポート担当

# ブログのアイキャッチ画像アップロード先（Vercel Blob）。
# Vercel の Storage で Blob ストアを作成すると自動で追加される。
# 未設定でもブログ記事は作れるが、画像アップロードだけ使えない。
BLOB_READ_WRITE_TOKEN=
