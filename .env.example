# Local dev (docker compose up -d):
DATABASE_URL="postgresql://levan:levan@localhost:5432/levan_dev?schema=public"

# Production (Vercel Postgres / Neon integration sets these automatically —
# usually as POSTGRES_URL / POSTGRES_URL_NON_POOLING; map them to these two
# names in Vercel's Environment Variables screen):
# DATABASE_URL   = pooled connection string (used by the app at runtime)
# DIRECT_URL     = non-pooled connection string (used only for migrations)

# Set to enable real LLM calls for Agent 01 / Agent 02. Without it, agents
# run in stub mode and return deterministic mock output (see src/agents/llm.ts).
ANTHROPIC_API_KEY=

# Required for auth (NextAuth). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
