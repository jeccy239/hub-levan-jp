// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Phase 1 scope: company -> lead -> outreach. Later phases extend this chain
// with customer/project/content tables without touching what's here.
// ---------------------------------------------------------------------------

enum LeadStatus {
  NEW
  RESEARCHED
  QUALIFIED
  CONTACTED
  REPLIED
  INTERESTED
  MEETING
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum OutreachDirection {
  OUTBOUND
  INBOUND
}

enum ReplyCategory {
  INTERESTED
  NOT_INTERESTED
  NEEDS_INFO
  UNSUBSCRIBE
  OUT_OF_OFFICE
  UNCLASSIFIED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserRole {
  ADMIN // 全権限
  MANAGER // 閲覧・編集・承認可、システム設定は不可
  STAFF // 自分が担当する顧客の編集のみ、他は閲覧のみ
  // 旧ロール。既存データ・移行のため残置（新規ユーザーには割り当てない）
  SALES
  OPERATOR
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String? // 未設定ユーザーはログイン不可（移行期間中の互換用）
  role         UserRole @default(STAFF)
  createdAt    DateTime @default(now())

  approvedMessages OutreachMessage[] @relation("ApprovedBy")
  auditLogs        AuditLog[]
  activities       Activity[]
  assignedTasks    Task[]
  uploadedFiles    FileAsset[]
}

model Company {
  id            String  @id @default(cuid())
  name          String
  nameKana      String?
  website       String
  industry      String?
  location      String? // 簡易住所（都道府県・市区町村程度）。詳細住所は下記
  employeeRange String?
  revenueRange  String?

  // WEBRIS メール管理のリサーチ対象カテゴリ（SEOツール/ヒートマップツール/LLMOツール利用中、広告代理店 等）
  toolInterest    String?
  // 国税庁法人番号（gBizINFO由来）。実在法人であることの裏付け＋重複防止。
  corporateNumber String?   @unique
  // サイト上で公開されている法人の問い合わせ先。特定電子メール法の
  // 「公開されている法人アドレス」例外に該当するもののみを保存する。
  publicEmail     String?
  // サイトのトップページで見つかったInstagramプロフィールリンク。個人EC
  // ショップはメールでの営業メール送信ではなくDM経由での営業を前提とする。
  instagramUrl    String?
  // サイト解析で検出したツール（Hotjar, GTM 等）とSEO上の不足点
  detectedTools   Json?
  seoGaps         Json?
  lastAuditedAt   DateTime?

  postalCode String?
  address    String? // 番地以降の詳細住所
  phone      String?
  note       String? @db.Text

  leadSourceId String?
  leadSource   LeadSource? @relation(fields: [leadSourceId], references: [id], onDelete: SetNull)

  statusId String?
  status   CompanyStatus? @relation(fields: [statusId], references: [id], onDelete: SetNull)

  firstContactAt DateTime?
  lastContactAt  DateTime?

  // Link to a WEBRIS (webris.levan.jp) Organization — a separate
  // product/codebase/DB. Stores only the foreign id; all other WEBRIS data
  // (plan, billing, contract dates) is fetched live via src/lib/webris.ts,
  // never duplicated here, so it can never drift out of sync.
  webrisOrganizationId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead             Lead?
  customer         Customer?
  outreachMessages OutreachMessage[]
  contacts         Contact[]
  activities       Activity[]
  tasks            Task[]
  tags             CompanyTag[]
  files            FileAsset[]
}

// ---------------------------------------------------------------------------
// Phase B scope: multi-contact companies, configurable status/source
// masters, and a general contact record. These sit alongside the existing
// Lead/Customer sales-pipeline models without replacing them — Company is
// now the durable "this is a business we know" record, while Lead/Customer
// remain the specific pipeline states a company can be in.
// ---------------------------------------------------------------------------

enum ContactRoleType {
  DECISION_MAKER // 決裁者
  OPERATIONAL // 実務担当者
  OTHER
}

model Contact {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name       String
  nameKana   String?
  department String?
  title      String?
  email      String?
  phone      String?
  mobile     String?
  roleType   ContactRoleType @default(OTHER)
  note       String?         @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities Activity[]

  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Phase C scope: cross-channel activity log, tasks, tags, and file links.
// All hang off Company, the durable hub record from Phase B.
// ---------------------------------------------------------------------------

enum ActivityType {
  PHONE
  EMAIL
  ZOOM
  VISIT
  INQUIRY
  PROPOSAL
  QUOTE
  CONTRACT
  OTHER
}

model Activity {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    ActivityType
  content String       @db.Text
  result  String?      @db.Text

  occurredAt     DateTime  @default(now())
  nextActionAt   DateTime?
  nextActionNote String?

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([occurredAt])
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  DOING
  DONE
}

model Task {
  id         String   @id @default(cuid())
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assigneeId String?
  assignee   User?    @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  title    String
  dueDate  DateTime?
  priority TaskPriority @default(MEDIUM)
  status   TaskStatus   @default(TODO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([assigneeId])
}

model Tag {
  id   String @id @default(cuid())
  name String @unique

  companies CompanyTag[]
}

model CompanyTag {
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([companyId, tagId])
}

// Metadata-only for now — points at an external URL (Drive/Dropbox/etc).
// Swappable for real object storage (e.g. Vercel Blob) later without
// touching callers, since they only ever deal with "a file has a name and
// a URL".
model FileAsset {
  id           String  @id @default(cuid())
  companyId    String
  company      Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User    @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  fileName String
  url      String
  note     String?

  createdAt DateTime @default(now())

  @@index([companyId])
}

// Master data, editable from settings later — not a fixed enum, per the
// requirement that statuses/sources must be addable without a code change.
model CompanyStatus {
  id        String    @id @default(cuid())
  name      String    @unique
  order     Int       @default(0)
  isDefault Boolean   @default(false)
  companies Company[]
}

model LeadSource {
  id        String    @id @default(cuid())
  name      String    @unique
  order     Int       @default(0)
  companies Company[]
}

model Lead {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  status           LeadStatus @default(NEW)
  seoScore         Int? // 0-100, from Agent 01
  potentialScore   Int? // 0-100, from Agent 01
  seoOpportunities Json? // structured findings from Agent 01
  reasonToContact  String?    @db.Text

  lastContactedAt DateTime?
  nextActionAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outreachMessages OutreachMessage[]
  decisionLogs     AiDecisionLog[]
  meetings         Meeting[]
  proposals        Proposal[]
  contract         Contract?

  @@index([status])
  @@index([potentialScore])
}

model OutreachMessage {
  id String @id @default(cuid())

  // 宛先の出どころは3通りある。営業パイプライン上のリード、CRM上の企業
  // （既存顧客を含む）、そして手入力アドレス。リードに紐づかない送信も
  // 記録・追跡できるよう leadId は任意にしてある。
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  // 実際に送った先。手入力宛先はここにしか残らないので、監査上も必須。
  toEmail   String?

  direction  OutreachDirection
  subject    String?
  body       String            @db.Text
  // "text" | "html" — 本文の記法。HTMLで送った文面をプレーン扱いで
  // 表示すると生タグが見えてしまうため、表示側の分岐に使う。
  bodyFormat String            @default("text")

  // outbound-only fields
  approvalStatus ApprovalStatus? // null for inbound messages
  approvedById   String?
  approvedBy     User?           @relation("ApprovedBy", fields: [approvedById], references: [id])
  sentAt         DateTime?

  // inbound-only fields
  replyCategory ReplyCategory?

  // engagement tracking (outbound-only) — set by the open-pixel / click
  // redirect endpoints under src/app/api/track/, never written by hand.
  openedAt  DateTime?
  clickedAt DateTime?

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Cross-cutting: every agent decision and every dollar spent is recorded here
// regardless of which phase produced it.
// ---------------------------------------------------------------------------

model AiDecisionLog {
  id         String @id @default(cuid())
  agentName  String // e.g. "lead_research_agent", "sales_agent"
  targetType String // e.g. "lead", "content_item"
  targetId   String

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  inputJson  Json
  decision   String @db.Text
  reason     String @db.Text
  outputJson Json

  model      String // e.g. "claude-sonnet-5"
  tokensUsed Int
  costUsd    Decimal @db.Decimal(10, 4)

  humanApprovedById String?
  finalResult       String? @db.Text

  createdAt DateTime @default(now())

  @@index([agentName])
  @@index([targetType, targetId])
}

// ---------------------------------------------------------------------------
// Phase 2 scope: meeting -> proposal -> contract. A lead becomes a Customer
// only once a Contract is signed; everything before that stays on Lead.
// ---------------------------------------------------------------------------

enum MeetingStatus {
  BRIEFED // Agent 03 produced a pre-meeting briefing, meeting not held yet
  HELD // transcript recorded, minutes summarized
}

enum ProposalStatus {
  PENDING // Agent 04 draft, awaiting human approval
  APPROVED
  REJECTED
}

model Meeting {
  id     String        @id @default(cuid())
  leadId String
  lead   Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  status MeetingStatus @default(BRIEFED)

  briefing       Json? // Agent 03 output: company/competitor/SEO/needs summary
  transcript     String? @db.Text // raw notes from the actual meeting
  minutesSummary String? @db.Text // Agent 04 summarization of the transcript

  heldAt    DateTime?
  createdAt DateTime  @default(now())

  proposals Proposal[]

  @@index([leadId])
}

model Proposal {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  meetingId String?
  meeting   Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  scopeJson    Json // proposed services, deliverables
  amountJpy    Decimal        @db.Decimal(12, 0)
  status       ProposalStatus @default(PENDING)
  approvedById String?

  createdAt DateTime  @default(now())
  contract  Contract?

  @@index([leadId])
}

model Customer {
  id        String   @id @default(cuid())
  companyId String   @unique
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  contracts       Contract[]
  project         Project?
  upsellProposals UpsellProposal[]
}

model Contract {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadId     String    @unique
  lead       Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  proposalId String?   @unique
  proposal   Proposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  plan          String // e.g. "SEO運用代行 基本プラン"
  monthlyFeeJpy Decimal  @db.Decimal(12, 0)
  startDate     DateTime
  renewalDate   DateTime

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Phase 3 scope: SEO production pipeline. One Project per signed contract;
// each Project owns a set of ContentItems moving through a fixed pipeline.
// ---------------------------------------------------------------------------

enum ContentStatus {
  KEYWORD // Agent 06 assigned a keyword + priority, no draft yet
  DRAFTED // Agent 07 wrote title/outline/body
  QC_REVIEWED // Agent 08 checked it; may or may not need a human
  HUMAN_REVIEW // QC flagged it (low score or YMYL) — human must review
  APPROVED // human signed off, ready to publish
  PUBLISHED
}

model Project {
  id         String   @id @default(cuid())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  contentItems ContentItem[]
  reports      Report[]
}

model ContentItem {
  id        String        @id @default(cuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status    ContentStatus @default(KEYWORD)

  keyword      String
  searchIntent String?
  priority     Int? // 1 = highest, from Agent 06

  title                  String?
  outlineJson            Json? // heading structure from Agent 07
  draftBody              String? @db.Text
  metaTitle              String?
  metaDescription        String?
  internalLinkCandidates Json?
  cta                    String?

  qcScore  Int? // 0-100, from Agent 08
  qcIssues Json?
  ymylFlag Boolean @default(false)

  publishedUrl String?
  publishedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Phase 4 scope: monthly reporting and upsell. Both agents only ever
// produce a draft — sending a report or presenting an upsell to the
// customer is always an explicit human action.
// ---------------------------------------------------------------------------

enum SendStatus {
  DRAFT
  APPROVED
  SENT
}

model Report {
  id        String     @id @default(cuid())
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  period    String // "2026-08"
  status    SendStatus @default(DRAFT)

  metricsJson Json // pv, users, queries, ranking, ctr, cv, cvr, publishedCount
  summaryText String @db.Text // Agent 09: what happened / why / what's next

  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([projectId, period])
}

enum UpsellStatus {
  PENDING // Agent 10 draft, awaiting human approval
  APPROVED // human approved, ready to present to the customer
  PRESENTED // human has shown it to the customer
  REJECTED
}

model UpsellProposal {
  id         String       @id @default(cuid())
  customerId String
  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status     UpsellStatus @default(PENDING)

  category  String // e.g. "Web制作", "AIチャットボット", "広告運用"
  rationale String @db.Text // why this benefits the customer specifically

  approvedById String?
  createdAt    DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Human operations audit trail — separate from AiDecisionLog, which records
// what the AI decided. This records what a logged-in person did.
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String // e.g. "lead.status_change", "proposal.approve", "user.login"
  targetType String
  targetId   String
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([targetType, targetId])
}

model CostLedgerEntry {
  id                 String  @id @default(cuid())
  customerLabel      String // Phase 1: free-text until Customer table exists
  period             String // "2026-08"
  aiCostUsd          Decimal @db.Decimal(10, 2)
  externalApiCostUsd Decimal @db.Decimal(10, 2)
  laborCostUsd       Decimal @db.Decimal(10, 2)
  revenueUsd         Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@unique([customerLabel, period])
}

// ---------------------------------------------------------------------------
// WEBRIS 契約通知の重複防止。WEBRIS側のOrganization（＝契約主体）を初めて
// 見たときに1行作り、その時点で email_info@levan.jp へ「契約しました」通知を
// 送る。次回以降のポーリングでは既存行があるので再送しない。
// ---------------------------------------------------------------------------
model WebrisContractNotice {
  webrisOrgId String   @id
  name        String
  accountType String // "company" | "manager"
  notifiedAt  DateTime @default(now())
  emailStatus String // 社内通知(email_info@levan.jp)の結果: "delivered" | "backfill" | "skipped:*" | "failed:*"
  // 新規登録者本人への自動サンクスメールの結果。未送信(無効時/管理者)はnull。
  thanksEmailStatus String?
}

// ---------------------------------------------------------------------------
// 汎用の設定キー/バリュー。今は「新規登録者への自動サンクスメール」の
// 有効/無効と文面を持つ（/sales-ai/compose で編集）。値は文字列で保存し、
// 真偽は "1" / "0" で表す。
// ---------------------------------------------------------------------------
model AppSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
