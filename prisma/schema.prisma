// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Phase 1 scope: company -> lead -> outreach. Later phases extend this chain
// with customer/project/content tables without touching what's here.
// ---------------------------------------------------------------------------

enum LeadStatus {
  NEW
  RESEARCHED
  QUALIFIED
  CONTACTED
  REPLIED
  INTERESTED
  MEETING
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum OutreachDirection {
  OUTBOUND
  INBOUND
}

enum ReplyCategory {
  INTERESTED
  NOT_INTERESTED
  NEEDS_INFO
  UNSUBSCRIBE
  OUT_OF_OFFICE
  UNCLASSIFIED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserRole {
  ADMIN
  SALES
  OPERATOR
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      UserRole @default(SALES)
  createdAt DateTime @default(now())

  approvedMessages OutreachMessage[] @relation("ApprovedBy")
}

model Company {
  id            String   @id @default(cuid())
  name          String
  website       String
  industry      String?
  location      String?
  employeeRange String?
  createdAt     DateTime @default(now())

  lead     Lead?
  customer Customer?
}

model Lead {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  status           LeadStatus @default(NEW)
  seoScore         Int? // 0-100, from Agent 01
  potentialScore   Int? // 0-100, from Agent 01
  seoOpportunities Json? // structured findings from Agent 01
  reasonToContact  String?    @db.Text

  lastContactedAt DateTime?
  nextActionAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outreachMessages OutreachMessage[]
  decisionLogs     AiDecisionLog[]
  meetings         Meeting[]
  proposals        Proposal[]
  contract         Contract?

  @@index([status])
  @@index([potentialScore])
}

model OutreachMessage {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  direction OutreachDirection
  subject   String?
  body      String            @db.Text

  // outbound-only fields
  approvalStatus ApprovalStatus? // null for inbound messages
  approvedById   String?
  approvedBy     User?           @relation("ApprovedBy", fields: [approvedById], references: [id])
  sentAt         DateTime?

  // inbound-only fields
  replyCategory ReplyCategory?

  createdAt DateTime @default(now())

  @@index([leadId])
}

// ---------------------------------------------------------------------------
// Cross-cutting: every agent decision and every dollar spent is recorded here
// regardless of which phase produced it.
// ---------------------------------------------------------------------------

model AiDecisionLog {
  id         String @id @default(cuid())
  agentName  String // e.g. "lead_research_agent", "sales_agent"
  targetType String // e.g. "lead", "content_item"
  targetId   String

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  inputJson  Json
  decision   String @db.Text
  reason     String @db.Text
  outputJson Json

  model      String // e.g. "claude-sonnet-5"
  tokensUsed Int
  costUsd    Decimal @db.Decimal(10, 4)

  humanApprovedById String?
  finalResult       String? @db.Text

  createdAt DateTime @default(now())

  @@index([agentName])
  @@index([targetType, targetId])
}

// ---------------------------------------------------------------------------
// Phase 2 scope: meeting -> proposal -> contract. A lead becomes a Customer
// only once a Contract is signed; everything before that stays on Lead.
// ---------------------------------------------------------------------------

enum MeetingStatus {
  BRIEFED // Agent 03 produced a pre-meeting briefing, meeting not held yet
  HELD // transcript recorded, minutes summarized
}

enum ProposalStatus {
  PENDING // Agent 04 draft, awaiting human approval
  APPROVED
  REJECTED
}

model Meeting {
  id     String        @id @default(cuid())
  leadId String
  lead   Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  status MeetingStatus @default(BRIEFED)

  briefing       Json? // Agent 03 output: company/competitor/SEO/needs summary
  transcript     String? @db.Text // raw notes from the actual meeting
  minutesSummary String? @db.Text // Agent 04 summarization of the transcript

  heldAt    DateTime?
  createdAt DateTime  @default(now())

  proposals Proposal[]

  @@index([leadId])
}

model Proposal {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  meetingId String?
  meeting   Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  scopeJson    Json // proposed services, deliverables
  amountJpy    Decimal        @db.Decimal(12, 0)
  status       ProposalStatus @default(PENDING)
  approvedById String?

  createdAt DateTime  @default(now())
  contract  Contract?

  @@index([leadId])
}

model Customer {
  id        String   @id @default(cuid())
  companyId String   @unique
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  contracts Contract[]
  project   Project?
}

model Contract {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadId     String    @unique
  lead       Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  proposalId String?   @unique
  proposal   Proposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  plan          String // e.g. "SEO運用代行 基本プラン"
  monthlyFeeJpy Decimal  @db.Decimal(12, 0)
  startDate     DateTime
  renewalDate   DateTime

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Phase 3 scope: SEO production pipeline. One Project per signed contract;
// each Project owns a set of ContentItems moving through a fixed pipeline.
// ---------------------------------------------------------------------------

enum ContentStatus {
  KEYWORD // Agent 06 assigned a keyword + priority, no draft yet
  DRAFTED // Agent 07 wrote title/outline/body
  QC_REVIEWED // Agent 08 checked it; may or may not need a human
  HUMAN_REVIEW // QC flagged it (low score or YMYL) — human must review
  APPROVED // human signed off, ready to publish
  PUBLISHED
}

model Project {
  id         String   @id @default(cuid())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  contentItems ContentItem[]
}

model ContentItem {
  id        String        @id @default(cuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status    ContentStatus @default(KEYWORD)

  keyword      String
  searchIntent String?
  priority     Int? // 1 = highest, from Agent 06

  title                  String?
  outlineJson            Json? // heading structure from Agent 07
  draftBody              String? @db.Text
  metaTitle              String?
  metaDescription        String?
  internalLinkCandidates Json?
  cta                    String?

  qcScore  Int? // 0-100, from Agent 08
  qcIssues Json?
  ymylFlag Boolean @default(false)

  publishedUrl String?
  publishedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
}

model CostLedgerEntry {
  id                 String  @id @default(cuid())
  customerLabel      String // Phase 1: free-text until Customer table exists
  period             String // "2026-08"
  aiCostUsd          Decimal @db.Decimal(10, 2)
  externalApiCostUsd Decimal @db.Decimal(10, 2)
  laborCostUsd       Decimal @db.Decimal(10, 2)
  revenueUsd         Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@unique([customerLabel, period])
}
